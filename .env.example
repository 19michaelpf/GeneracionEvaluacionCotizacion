# Copie este archivo como .env.local y complete los valores de su proyecto Supabase
# (Project Settings > API). Nunca suba .env.local al repositorio.

# Públicas: se envían al navegador. La anon key es segura porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privada (solo servidor): se usa ÚNICAMENTE para subir los PDF generados al bucket privado.
# Nunca la prefije con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Privadas (solo servidor): asistencia de IA para redactar los textos del PDF.
# Sin ANTHROPIC_API_KEY la app funciona igual y usa la plantilla estándar.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=
